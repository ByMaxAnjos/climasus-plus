version: 1.0.1
date-released: "2026-08-22"
license: MIT
repository-code: "https://github.com/ByMaxAnjos/climasus-plus"
keywords:
  - climate and health
  - DATASUS
  - pipeline
  - reproducible research
  - R
  - epidemiology
